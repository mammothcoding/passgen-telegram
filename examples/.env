##### TG ############################################

TG_BOTS_IDENTIFIERS=123456789:ABCDEFGHJKMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz|https://tg.bot.serv.my|0.0.0.0:8001|@tg_bot_alias_name_to_display_instead_of_an_bot_id_in_statistics_and_logs
#For many bots example:
#TG_BOTS_IDENTIFIERS=123456789:ABCDEFGHJKMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz|https://tg.bot.serv.my|0.0.0.0:8001|@tg_bot_alias,9876543210:ABCDEFGHJKMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz|https://tg.bot2.serv.my|0.0.0.0:8002|@tg_bot2_alias
#For long polling with proxy you may leave webhook URL and socket empty:
#TG_BOTS_IDENTIFIERS=123456789:ABCDEFGHJKMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz|||@tg_bot_alias
### 🡓 If TG_PROXY_ADDR is empty, the service uses webhook mode as before.
### 🡓 If TG_PROXY_ADDR is set, the service switches to long polling and uses this HTTP proxy for Telegram API requests.
### 🡓 [Optional, default is empty]
TG_PROXY_ADDR=
### 🡓 Proxy port used together with TG_PROXY_ADDR. Required only when TG_PROXY_ADDR is set.
TG_PROXY_PORT=

##### DB ############################################

DB_HOST=192.168.0.5
### 🡓 Postgres server port. [Optional, default is 5432]
DB_PORT=5432
### 🡓 Postgres DB name. [Optional, default is "tg_passgen_db"]
DB_NAME=tg_passgen_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

##### LOG ###########################################

### 🡓 Possible log levels: error, info, warn, debug, trace. [Optional, default is Off]
LOG_STDERR_LVL=info
LOG_LOGFILE_LVL=debug
### 🡓 This is the size at which a new log file should be created. [Optional, default is 1048576 bytes]
LOG_TRIGGER_FILE_SIZE=1048576
### 🡓 Number of archive log files to keep. [Optional, default is 5]
LOG_FILES_COUNT=5
### 🡓 Location where logs will be written to. May be relative or absolute. [Optional, default is "log" catalogue near binary file]
LOG_FILES_PATH=logs

##### WEB-STAT ######################################

WEB_STAT_SOCKET_ADDR=0.0.0.0:8001
### 🡓 Comma-separated array. 0 or more telegram user id may be specified. [Optional, default is empty array]
WEB_STAT_ACCESS_TG_USER_IDS=1234567890,7894561230
### 🡓 Comma-separated array. Each element of the array must include a name of the link to the statistics
### 🡓 and link address with port, separated by “|”. 0 or more name|address pairs may be specified.
### 🡓 [Optional, default is empty array]
WEB_STAT_ADDRS=stat-glob|https://stat.tg.bot.serv.my,stat-loc|http://192.168.0.33:8001
### 🡓 Seconds number for timeout beetween updatings of statistical global varibales (tg_users count, gens_count) from DB.
### 🡓 [Optional, default is 3600]
STATISTICAL_GLOB_VARS_UPDATE_TIMEOUT=3600
