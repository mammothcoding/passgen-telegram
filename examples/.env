### TG
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHJKMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz
TELEGRAM_WEBHOOK_URL=https://tg.bot.serv.my
TELEGRAM_BOT_SOCKET_ADDR=0.0.0.0:8000

### DB
DB_HOST=192.168.0.5
# 🡓 Postgres server port. [Optional, default is 5432]
DB_PORT=5432
# 🡓 Postgres DB name. [Optional, default is "tg_passgen_db"]
DB_NAME=tg_passgen_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

### LOG
# 🡓 Possible log levels: error, info, warn, debug, trace. [Optional, default is Off]
LOG_STDERR_LVL=info
LOG_LOGFILE_LVL=debug
# 🡓 This is the size at which a new log file should be created. [Optional, default is 1048576 bytes]
LOG_TRIGGER_FILE_SIZE=1048576
# 🡓 Number of archive log files to keep. [Optional, default is 5]
LOG_FILES_COUNT=5
# 🡓 Location where logs will be written to. May be relative or absolute. [Optional, default is "log" catalogue near binary file]
LOG_FILES_PATH=logs
